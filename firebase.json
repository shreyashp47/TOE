{
  "hosting": {
    "public": "out",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "out/**"],
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      {
        "//": "Mirrors the headers() block in next.config.ts. Static export makes Next drop that block silently, so these are re-declared here; without this the app would ship with no nosniff and no frame protection.",
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "//": "The staff board uses vibration for the new-order alert; nothing else is needed, so everything else is denied.",
            "value": "geolocation=(), microphone=(), camera=(), payment=()"
          }
        ]
      },
      {
        "//": "Firebase sends no-store for everything by default, which would re-download every hashed chunk on each visit and defeat the point of the 103 kB budget. These filenames change whenever their contents do, so they can be kept forever.",
        "source": "/_next/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "//": "A stale service worker can pin an old app shell on the counter phone indefinitely.",
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          },
          { "key": "Service-Worker-Allowed", "value": "/" }
        ]
      },
      {
        "source": "/manifest.webmanifest",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
    "hosting": { "port": 5005 },
    "ui": { "enabled": true }
  }
}
